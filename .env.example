# Copy this template to a protected local .env file if your launcher loads it.
# BizAgents does not automatically load .env files. Never commit real secrets.

# Claude API
ANTHROPIC_API_KEY=replace-with-your-claude-api-key

# Search provider (use the key for the provider selected later)
TAVILY_API_KEY=replace-with-your-tavily-api-key
SERPER_API_KEY=replace-with-your-serper-api-key

# Company data providers (use only providers selected later)
APOLLO_API_KEY=replace-with-your-apollo-api-key
CRUNCHBASE_API_KEY=replace-with-your-crunchbase-api-key

# PostgreSQL connection string
DATABASE_URL=postgresql+psycopg://<user>:<password>@<host>:5432/<database>

# Arize Phoenix tracing (disabled by default; use a local Phoenix server or
# your Phoenix Cloud endpoint when enabling)
BIZAGENTS_TRACING_ENABLED=false
PHOENIX_PROJECT_NAME=bizagents
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006/v1/traces
PHOENIX_API_KEY=
ARIZE_API_KEY=replace-with-your-arize-api-key

# Speech-to-text providers
DEEPGRAM_API_KEY=replace-with-your-deepgram-api-key
WHISPER_API_KEY=replace-if-required-by-your-whisper-provider

# Text-to-speech providers
ELEVENLABS_API_KEY=replace-with-your-elevenlabs-api-key
GOOGLE_TTS_API_KEY=replace-if-required-by-your-google-tts-setup

# Email providers
SENDGRID_API_KEY=replace-with-your-sendgrid-api-key
GMAIL_CLIENT_ID=replace-with-your-gmail-oauth-client-id
GMAIL_CLIENT_SECRET=replace-with-your-gmail-oauth-client-secret
GMAIL_REFRESH_TOKEN=replace-with-your-gmail-oauth-refresh-token
